class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_map <char,int> hash;
        
        int left =0;
        int maxLen = 0;

        for(int right =0; right < s.length(); right++){
            if(hash.find(s[right])!= hash.end()){
                left = max (left,hash[s[right]]+1);
            }
            hash[s[right]] = right;
            maxLen = max(maxLen, right - left +1);
        }
        return maxLen;
    }
};
